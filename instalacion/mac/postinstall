#!/bin/bash
# Lo ejecuta el instalador de Apple (Instalar-Manna-Mac.pkg) al final, como administrador. Instala Manna para quien
# tiene la sesión abierta, como esa persona, con el mismo «Instalar Manna en Mac.command» (va junto a este archivo
# dentro del .pkg), sin Terminal: lo que escribe queda en /var/log/install.log. Al terminar abre Manna; si algo
# falla, lo dice en una ventana y el instalador de Apple avisa de que no terminó.
# MANNA_PKG_USUARIO (solo para la prueba en GitHub, que lo ejecuta con sudo): la persona, si no hay sesión abierta;
# con él no se abre ninguna ventana ni Manna (allí no hay pantalla, y un aviso se quedaría esperando).
USUARIO="$(stat -f%Su /dev/console)"
if [ -z "$USUARIO" ] || [ "$USUARIO" = root ]; then USUARIO="$MANNA_PKG_USUARIO"; fi
if [ -z "$USUARIO" ] || ! id "$USUARIO" >/dev/null 2>&1; then echo "Manna: no hay nadie con la sesión abierta."; exit 1; fi
UID_USUARIO="$(id -u "$USUARIO")"
CASA="$(dscl . -read "/Users/$USUARIO" NFSHomeDirectory | awk '{ print $2 }')"

# El instalador, en una carpeta a la que la persona pueda entrar: ni la de los guiones del .pkg ni la temporal del
# administrador se lo dejan.
TRABAJO="$(mktemp -d /tmp/manna-instalar.XXXXXX)"
cp "$(dirname "$0")/instalar.command" "$TRABAJO/instalar.command"
touch "$TRABAJO/error"
chown -R "$USUARIO" "$TRABAJO"
trap 'rm -rf "$TRABAJO"' EXIT

ventana() { [ -n "$MANNA_PKG_USUARIO" ] && return; launchctl asuser "$UID_USUARIO" sudo -u "$USUARIO" /usr/bin/osascript -e "display alert \"Manna\" message \"$1\"" >/dev/null 2>&1; }
cd "$TRABAJO" || exit 1
if ! sudo -u "$USUARIO" -H env HOME="$CASA" MANNA_PKG=1 MANNA_PKG_ERROR="$TRABAJO/error" /bin/bash "$TRABAJO/instalar.command" < /dev/null; then
  echo "Manna: no se pudo instalar. $(cat "$TRABAJO/error")"
  ventana "No se pudo instalar Manna. $(tr '"\\' "' " < "$TRABAJO/error")"
  exit 1
fi

# Abre Manna en la sesión de la persona: la app que acaba de crear el instalador.
[ -n "$MANNA_PKG_USUARIO" ] && exit 0
for APP in /Applications/Manna.app "$CASA/Applications/Manna.app"; do
  if [ -f "$APP/Contents/Resources/creada-por-manna" ]; then
    launchctl asuser "$UID_USUARIO" sudo -u "$USUARIO" /usr/bin/open "$APP" >/dev/null 2>&1
    break
  fi
done
exit 0
